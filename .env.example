# ─── Gemini AI ────────────────────────────────────────────────────────────────
#
# LOCAL DEVELOPMENT (npm run dev)
# Set VITE_GEMINI_API_KEY here so Vite can expose it to the browser as a
# fallback when the local /api/gemini proxy is not running.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
#
# VERCEL PRODUCTION (IMPORTANT: server-only, never VITE_ prefix!)
# In the Vercel dashboard go to:
#   Project → Settings → Environment Variables
# Add:
#   Name:  GEMINI_API_KEY   (without VITE_ prefix!)
#   Value: <your Gemini API key from https://aistudio.google.com/app/apikey>
#   Scope: Production + Preview (+ Development if you use vercel dev)
#
# The key is read exclusively by the /api/gemini serverless function –
# it is NEVER shipped in the client-side JavaScript bundle.
#
# ─── Supabase Cloud Database & Auth ──────────────────────────────────────────
# These are safe to expose with the VITE_ prefix (they are public anon keys)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
